<Window x:Class="FreeAutocorrect.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeAutocorrect Floating Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45"/>
    </Window.Resources>

    <Grid Margin="8">
        <Border x:Name="PillBorder"
                Background="Transparent"
                BorderBrush="#334155"
                BorderThickness="0"
                CornerRadius="20"
                Padding="0"
                MouseEnter="PillBorder_MouseEnter"
                MouseLeave="PillBorder_MouseLeave"
                Effect="{StaticResource Shadow}">
            
            <StackPanel Orientation="Vertical">
                <!-- 1. Sleek Minimized Floating Icon (Default idle state: ultra-compact 26x26) -->
                <Border x:Name="IconOnlyView" 
                        Background="#10B981" 
                        BorderBrush="#059669"
                        BorderThickness="1"
                        Width="26" 
                        Height="26" 
                        CornerRadius="13" 
                        Cursor="Hand" 
                        MouseLeftButtonDown="IconOnlyView_MouseLeftButtonDown"
                        ToolTip="FreeAutocorrect (Hover to expand, right-click to minimize)">
                    <Border.ContextMenu>
                        <ContextMenu Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC">
                            <MenuItem Header="📝 Open Full Assistant" Click="ContextOpenAssistant_Click"/>
                            <MenuItem Header="🔍 Check Text" Click="ContextCheckText_Click"/>
                            <Separator Background="#334155"/>
                            <MenuItem Header="➖ Minimize to System Tray" Click="ContextMinimizeToTray_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock x:Name="IconBadgeText" Text="✓" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 2. Expanded Status Pill View (Expands on touch/hover) -->
                <StackPanel x:Name="CollapsedView" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="6,2">
                    <Border Background="#10B981" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                        <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="StatusText" 
                               Text="FreeAutocorrect: Active" 
                               Foreground="#F8FAFC" 
                               FontWeight="SemiBold" 
                               FontSize="12" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>

                    <Button x:Name="ExpandButton"
                            Content="🔍 Check / Expand"
                            Click="ExpandButton_Click"
                            Background="#334155"
                            Foreground="#E2E8F0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Minimize floating pill button -->
                    <Button Content="—" 
                            Click="MinimizeToTray_Click"
                            Background="Transparent" 
                            Foreground="#94A3B8" 
                            FontSize="12" 
                            FontWeight="Bold"
                            BorderThickness="0" 
                            Margin="6,0,0,0" 
                            Cursor="Hand"
                            ToolTip="Minimize floating icon to system tray"/>

                    <Button Content="✕" 
                            Click="HideButton_Click"
                            Background="Transparent" 
                            Foreground="#94A3B8" 
                            FontSize="12" 
                            FontWeight="Bold"
                            BorderThickness="0" 
                            Margin="4,0,0,0" 
                            Cursor="Hand"
                            ToolTip="Close"/>
                </StackPanel>

                <!-- 3. Live Suggestion Notification Banner -->
                <Border x:Name="LiveSuggestionBanner" Visibility="Collapsed" Background="#0F172A" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="12" Padding="10,6" Margin="0,6,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="BtnApplyLive" Content="✓ Replace" Click="BtnApplyLive_Click" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,3" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnDismissLive" Content="✕" Click="BtnDismissLive_Click" Background="Transparent" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Padding="4,2" BorderThickness="0" Cursor="Hand" ToolTip="Dismiss suggestion"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                <TextBlock Text="⚡ FIX" Foreground="#60A5FA" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#3F1D24" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,5,0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TxtLiveTypo" Text="typo" Foreground="#FCA5A5" TextDecorations="Strikethrough" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    <Path Stroke="#EF4444" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,1,0,0" Data="M 0,1 Q 2,0 4,1 T 8,1 T 12,1 T 16,1 T 20,1 T 24,1 T 28,1 T 32,1 T 36,1 T 40,1 T 44,1 T 48,1 T 52,1 T 56,1 T 60,1 T 64,1 T 68,1 T 72,1 T 76,1 T 80,1"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="➔" Foreground="#94A3B8" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="TxtLiveFix" Text="fix" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 4. Live Tab / Hotkey Autocomplete Banner -->
                <Border x:Name="TabCompletionBanner" Visibility="Collapsed" Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="10,6" Margin="0,6,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button x:Name="BtnApplyAutoFinish" Content="✓ Finish" Click="BtnApplyAutoFinish_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,3" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAutoFinishKeyBadge" Text="Press Tab + ➔" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                <TextBlock Text="✨ FINISH" Foreground="#38BDF8" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="TxtTabCompletion" Text="suggestion" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 5. Hard Word Underline Banner -->
                <Border x:Name="HardWordBanner" Visibility="Collapsed" Background="#1E1E2E" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="12" Padding="10,6" Margin="0,6,0,0">
                    <StackPanel Orientation="Vertical">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" Click="BtnDismissHardWord_Click" Background="Transparent" Foreground="#FCD34D" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" ToolTip="Dismiss"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#78350F" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                    <TextBlock Text="⚠️ UNKNOWN" Foreground="#FDE68A" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="TxtHardWord" Text="word" Foreground="#FDE68A" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                        <Path Stroke="#F59E0B" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,1,0,0" Data="M 0,1 Q 2,0 4,1 T 8,1 T 12,1 T 16,1 T 20,1 T 24,1 T 28,1 T 32,1 T 36,1 T 40,1 T 44,1 T 48,1 T 52,1 T 56,1 T 60,1 T 64,1 T 68,1 T 72,1 T 76,1 T 80,1"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Did you mean:" Foreground="#CBD5E1" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="HardWordCandidatesPanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6. Expanded Suggestions View -->
                <StackPanel x:Name="ExpandedView" Visibility="Collapsed" Margin="0,10,0,0" MinWidth="340" MaxWidth="420">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Suggestions &amp; Quick Fixes" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold"/>
                            <Border x:Name="BadgeExpandedCount" Background="#2563EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtExpandedCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Collapse ▲" Click="CollapseButton_Click" Background="Transparent" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    </DockPanel>

                    <!-- Suggestions list -->
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SuggestionsList"/>
                    </ScrollViewer>

                    <Separator Background="#334155" Margin="0,10,0,10"/>

                    <!-- Action buttons -->
                    <DockPanel LastChildFill="False">
                        <Button Content="📝 Open Full Assistant" 
                                Click="OpenAssistant_Click"
                                Background="#334155" 
                                Foreground="#F8FAFC" 
                                FontWeight="SemiBold" 
                                FontSize="12" 
                                Padding="12,6" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button DockPanel.Dock="Right"
                                Content="⚡ Apply All" 
                                Click="ApplyAll_Click"
                                Background="#10B981" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="12" 
                                Padding="12,6" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
