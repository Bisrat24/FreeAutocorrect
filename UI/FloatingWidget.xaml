<Window x:Class="FreeAutocorrect.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeAutocorrect Floating Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45"/>
    </Window.Resources>

    <Grid Margin="15">
        <Border x:Name="PillBorder"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="24"
                Padding="6"
                MouseEnter="PillBorder_MouseEnter"
                MouseLeave="PillBorder_MouseLeave"
                Effect="{StaticResource Shadow}">
            
            <StackPanel Orientation="Vertical">
                <!-- 1. Icon-Only Minimized View (Default idle state) -->
                <Border x:Name="IconOnlyView" 
                        Background="#10B981" 
                        Width="34" 
                        Height="34" 
                        CornerRadius="17" 
                        Cursor="Hand" 
                        MouseLeftButtonDown="IconOnlyView_MouseLeftButtonDown"
                        ToolTip="FreeAutocorrect (Hover or click to expand)">
                    <TextBlock x:Name="IconBadgeText" Text="✓" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 2. Expanded Status Pill View (Expands on touch/hover) -->
                <StackPanel x:Name="CollapsedView" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="6,2">
                    <Border Background="#10B981" Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0">
                        <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="StatusText" 
                               Text="FreeAutocorrect: Active" 
                               Foreground="#F8FAFC" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>

                    <Button x:Name="ExpandButton"
                            Content="🔍 Check / Expand"
                            Click="ExpandButton_Click"
                            Background="#334155"
                            Foreground="#E2E8F0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="✕" 
                            Click="HideButton_Click"
                            Background="Transparent" 
                            Foreground="#94A3B8" 
                            FontSize="12" 
                            FontWeight="Bold"
                            BorderThickness="0" 
                            Margin="8,0,0,0" 
                            Cursor="Hand"/>
                </StackPanel>

                <!-- 3. Live Suggestion Notification Banner -->
                <Border x:Name="LiveSuggestionBanner" Visibility="Collapsed" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="0,6,0,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" x:Name="BtnApplyLive" Content="✓ Apply" Click="BtnApplyLive_Click" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,2" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock x:Name="TxtLiveSuggestion" Text="💡 Suggestion: 'worrrking' → 'working'" Foreground="#A7F3D0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 4. Live Tab + Right Arrow Autocomplete Banner -->
                <Border x:Name="TabCompletionBanner" Visibility="Collapsed" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="0,6,0,0">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Press Tab + ➔" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="TxtTabCompletion" Text="✨ Auto-finish: suggestion" Foreground="#BFDBFE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 5. Hard Word Underline Banner (Underline for words hard for suggestion) -->
                <Border x:Name="HardWordBanner" Visibility="Collapsed" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,6,0,0">
                    <StackPanel Orientation="Vertical">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" Click="BtnDismissHardWord_Click" Background="Transparent" Foreground="#FCA5A5" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ " FontSize="12"/>
                                <TextBlock x:Name="TxtHardWord" Text="word" Foreground="#FCA5A5" FontWeight="Bold" FontSize="12" TextDecorations="Underline"/>
                                <TextBlock Text=" (hard to suggest):" Foreground="#FECACA" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="HardWordCandidatesPanel" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6. Expanded Suggestions View -->
                <StackPanel x:Name="ExpandedView" Visibility="Collapsed" Margin="0,10,0,0" MinWidth="340" MaxWidth="420">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Suggestions &amp; Quick Fixes" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Collapse ▲" Click="CollapseButton_Click" Background="Transparent" Foreground="#60A5FA" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                    </DockPanel>

                    <!-- Suggestions list -->
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SuggestionsList"/>
                    </ScrollViewer>

                    <Separator Background="#334155" Margin="0,10,0,10"/>

                    <!-- Action buttons -->
                    <DockPanel LastChildFill="False">
                        <Button Content="📝 Open Full Assistant" 
                                Click="OpenAssistant_Click"
                                Background="#2563EB" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                FontSize="12" 
                                Padding="12,6" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button DockPanel.Dock="Right"
                                Content="⚡ Apply All" 
                                Click="ApplyAll_Click"
                                Background="#10B981" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                FontSize="12" 
                                Padding="12,6" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
